<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Phoebe</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- Force dark appearance app-wide. Phoebe is a dark-only app, so we
	     never want the system to render the WKWebView (or native UI like
	     the keyboard and menus) in light mode. Crucially this also makes
	     embedded cross-origin reflections that follow prefers-color-scheme
	     in their default "auto" theme — Forward Day by Day, SSJE — render
	     dark inline: we can't set their cross-origin theme storage, but a
	     dark WebView reports `prefers-color-scheme: dark` to every frame. -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>

	<!-- Usage descriptions — shown in system permission prompts. Apple
	     rejects builds missing these when the corresponding API is
	     referenced. Copy here must match the feature in context. -->
	<key>NSContactsUsageDescription</key>
	<string>Phoebe uses your contacts so you can invite people you already know — just like a party app. Nothing is sent to our servers unless you choose to invite someone.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Phoebe uses Face ID so only you can open your prayer intentions.</string>
	<key>NSCameraUsageDescription</key>
	<string>Phoebe uses your camera so you can take a profile photo.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Phoebe uses your microphone so you can record a short voice prayer for a fellow. It is encrypted on your device and deleted the moment they hear it.</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>Phoebe plays a contemplative playlist while you breathe with Cobreathe. It only plays music — it never reads your listening history.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Phoebe uses your photos so you can choose a profile picture.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Phoebe reads your Mindful Minutes from Apple Health so time you spend in meditation or silence — including in apps like Calm or Insight Timer — can count toward your daily contemplation goal.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Phoebe saves your contemplative sits to Apple Health as Mindful Minutes, so the silence you keep here shows up alongside your other mindfulness time.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>If you turn it on, Phoebe attaches a rough (about a mile) location when you pray for someone, so they can see a map of the places their prayers came from. Your exact location is never shared, and this stays off until you enable it.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>If you turn it on, Phoebe attaches a rough (about a mile) location when you pray for someone, so they can see a map of the places their prayers came from. Your exact location is never shared, and this stays off until you enable it.</string>

	<!-- Background modes:
	     • remote-notification — silent push wake-up; bell scheduling uses it.
	     • audio — keeps AVAudioSession alive while the phone is locked
	       so the contemplation closing bell rings reliably mid-sit, the
	       same model Insight Timer / Calm use for end-of-session sounds.
	       PhoebeAudioPlugin.swift owns the session (category .playback,
	       ignores the silent switch) and loops a near-zero-volume silent
	       buffer to keep iOS from suspending us between schedule + bell. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>audio</string>
	</array>

	<!-- iOS 17+ asks for permission to use non-public APIs even for
	     simple defaults like UserDefaults. Our PrivacyInfo.xcprivacy
	     covers the formal declaration; this entry covers the audit. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Home-screen quick actions (long-press the app icon).
	     Static shortcuts ship in Info.plist so they're always
	     present without runtime registration. AppDelegate's
	     `application(_:performActionFor:completionHandler:)` maps
	     each `UIApplicationShortcutItemType` to a deep-link path
	     by posting the matching universal-link URL through the
	     existing native-shell appUrlOpen path — same routing
	     mechanism the rest of the deep-link wiring uses. -->
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<!-- Mirror of the home dashboard's "Begin prayer" CTA.
			     The shortcut points at /begin-prayer which runs the
			     same time-of-day + defaultPrayerLevel + prayedToday
			     logic the home card runs and replaces history with
			     the resolved destination. Type identifier is the
			     legacy "prayer-list" name so devices that cached the
			     old shortcut from a prior install keep working — the
			     Swift mapping below now points it at /begin-prayer. -->
			<key>UIApplicationShortcutItemType</key>
			<string>app.withphoebe.mobile.shortcut.prayer-list</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Begin prayer</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Today's next rhythm</string>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeFavorite</string>
		</dict>
		<dict>
			<!-- Lands on /contemplation — the silent-sit timer. -->
			<key>UIApplicationShortcutItemType</key>
			<string>app.withphoebe.mobile.shortcut.contemplation</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Start contemplation</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Sit in silence</string>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypePause</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>app.withphoebe.mobile.shortcut.prayer-request-new</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>New prayer request</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Share what to carry</string>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeAdd</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>app.withphoebe.mobile.shortcut.letter-new</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Write a letter</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>To one friend</string>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeCompose</string>
		</dict>
	</array>
</dict>
</plist>
