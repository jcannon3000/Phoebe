auto-install-peers=false
strict-peer-dependencies=false

# Hoist packages that the api-server's esbuild bundle externalizes (see
# artifacts/api-server/build.mjs `external: [...]`). pnpm's default
# strict layout keeps transitive deps under node_modules/.pnpm/ where
# our bundled dist/index.mjs can't resolve them — node's ESM resolver
# walks up from the dist directory looking for a plain node_modules/<pkg>
# folder. Hoisting forces these packages into the root node_modules so
# the resolution finds them.
#
# @opentelemetry/* + @sentry/* + import-in-the-middle are dragged in
# transitively by @sentry/node@8.x. Without these patterns the Railway
# deploy crashes on boot with ERR_MODULE_NOT_FOUND for
# @opentelemetry/semantic-conventions (and would cascade to the others).
public-hoist-pattern[]=@opentelemetry/*
public-hoist-pattern[]=@sentry/*
public-hoist-pattern[]=import-in-the-middle
public-hoist-pattern[]=require-in-the-middle
